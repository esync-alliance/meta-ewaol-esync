[Unit]
Description=Deploy eSync-Client Demo to SOAFEE Framework (k3s)
Wants=esync-macaddr-monitor.service k3s.service esync-macaddr-monitor.service
After=esync-macaddr-monitor.service k3s.service esync-macaddr-monitor.service

[Service]
Type=oneshot
ExecStartPre=/usr/bin/sleep 15
ExecStart=@ESCLIENT_PRIV_DIR@/kubeconfigs/deploy.sh
ExecStartPost=/bin/systemctl disable esync-deployment-helper.service

[Install]
WantedBy=multi-user.target
